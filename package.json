{
  "name": "travel-archive",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter ./apps/web run dev",
    "build": "pnpm --filter ./apps/web run build",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/api",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-map-worker.mjs",
    "db:test": "bash scripts/db-check.sh",
    "api:build": "pnpm --filter ./apps/api run build",
    "contract:generate": "node scripts/openapi.mjs && openapi-typescript openapi/openapi.yaml -o packages/api-client/src/schema.d.ts"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "jose": "6.2.11",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@biomejs/biome": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "fake-indexeddb": "^6.2.5",
    "i18n-iso-countries": "^7.14.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "latest",
    "vitest": "latest",
    "world-countries": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.11.0"
}
